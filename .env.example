# --- Required ---------------------------------------------------------------
# Embeddings are OpenAI-only (Anthropic has no embeddings endpoint), so
# retrieval needs this key even when Claude generates the answers.
OPENAI_API_KEY=sk-proj-...

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# --- Answer provider --------------------------------------------------------
# Claude is used for answers when this is set; otherwise OpenAI is used.
# Official keys start with "sk-ant-".
ANTHROPIC_API_KEY=

# Optional. Leave unset to use the official API (api.anthropic.com).
# Whatever you point this at receives every question and retrieved passage.
# ANTHROPIC_BASE_URL=

# --- Required for indexing --------------------------------------------------
# Reads use the anon key; writes bypass RLS and need the service-role key.
# Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Any random string. POST /crawl is disabled entirely until this is set,
# and callers must send it as the x-crawl-secret header.
# (`npm run index` runs locally and does not need it.)
CRAWL_SECRET=

# --- Optional tuning --------------------------------------------------------
PORT=3000
# CLAUDE_ANSWER_MODEL=claude-opus-5
# CLAUDE_UTILITY_MODEL=claude-haiku-4-5
# CLAUDE_EFFORT=medium
# OPENAI_ANSWER_MODEL=gpt-4o-mini
# RETRIEVAL_CANDIDATES=20
# RETRIEVAL_TOP_K=6
# RATE_LIMIT_PER_MINUTE=12
